{
  "name": "io2script",
  "version": "1.0.0",
  "description": "High-throughput streaming tick-by-tick market data CSV processor",
  "main": "src/index.js",
  "type": "module",
  "author": "avi <mebeingasravi>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/index.js",
    "start": "npm test && node src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "staging": "npm test && NODE_ENV=staging node src/index.js",
    "production": "npm test && NODE_ENV=production node src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**",
      "!src/index.js"
    ]
  },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "fsevents@2.3.3": true
  }
}
