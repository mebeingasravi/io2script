PORT=3000

INPUT_FILE=data/sample.csv

LOG_PATH=logs

NODE_ENV=development

# --- Script Management API / Database ---
DATABASE_URL=postgres://io2script:io2script@localhost:5432/io2script
DB_LOGGING=false

# --- Auth ---
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d

# --- Python process management ---
PYTHON_EXECUTABLE=python3
PYTHON_SCRIPTS_DIR=python_scripts

# --- Cron ---
# Repeating pull during the morning window (every 5 min, 6:00-8:55 IST)
SCRIPT_CRON_SCHEDULE=0 */5 6,7,8 * * *
# Final sweep at the end of the window (9:00:00 IST sharp)
SCRIPT_CRON_END_SCHEDULE=0 0 9 * * *

# --- SSH / SCP Configuration ---

# Source Server
SRC_HOST=
SRC_PORT=22
SRC_USER=
SRC_KEY=./python_scripts/ci-cd-test.pem

# Destination Server
DEST_HOST=
DEST_PORT=22
DEST_USER=
DEST_KEY=./python_scripts/ci-cd-test.pem

# Directory Paths (files are copied into DEST_DIR/<YYYY-MM-DD>/)
SOURCE_DIR=/home/ubuntu
DEST_DIR=/home/ubuntu/move
