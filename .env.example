PORT=3000

INPUT_FILE=data/sample.csv

LOG_PATH=logs

NODE_ENV=development

# --- Script Management API / Database ---
DATABASE_URL=postgres://io2script:io2script@localhost:5432/io2script
DB_LOGGING=false

# --- Auth ---
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d

# --- Python process management ---
PYTHON_EXECUTABLE=python3
PYTHON_SCRIPTS_DIR=python_scripts

# --- Cron ---
SCRIPT_CRON_SCHEDULE=* * * * *
